        "id": "mqtt-alert-publish",
        "type": "mqtt out",
        "z": "ming-flow-tab-main",
        "name": "Publish Alert",
        "topic": "factory/alerts",
        "qos": "1",
        "retain": "false",
        "respTopic": "",
        "contentType": "application/json",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "mqtt-broker-config",
        "x": 870,
