        "name": "Generate Test Data",
        "func": "// 테스트 센서 데이터 생성\nconst baseTemp = 25;\nconst baseHumidity = 60;\nconst basePressure = 1.0;\n\n// 약간의 변동 추가\nconst data = {\n    temperature: baseTemp + (Math.random() * 10 - 5),\n    humidity: baseHumidity + (Math.random() * 20 - 10),\n    pressure: basePressure + (Math.random() * 0.2 - 0.1),\n    motor_speed: Math.floor(1500 + Math.random() * 200),\n    vibration: Math.random() * 2,\n    power_consumption: 45 + Math.random() * 10\n};\n\n// 소수점 2자리로 반올림\nfor (let key in data) {\n    if (typeof data[key] === 'number') {\n        data[key] = Math.round(data[key] * 100) / 100;\n    }\n}\n\nmsg.topic = 'factory/line1/simulator/data';\nmsg.payload = data;\n\nreturn msg;",
