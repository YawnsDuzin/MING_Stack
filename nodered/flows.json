    {
        "id": "parse-mqtt-topic",
        "type": "function",
        "z": "ming-flow-tab-main",
        "name": "Parse Topic & Transform",
        "func": "// MQTT 토픽 파싱: factory/{line}/{device}/data\nconst parts = msg.topic.split('/');\n\nmsg.measurement = 'sensor_data';\nmsg.tags = {\n    line: parts[1] || 'unknown',\n    device: parts[2] || 'unknown'\n};\nmsg.fields = msg.payload;\nmsg.timestamp = new Date();\n\n// InfluxDB 형식으로 변환\nmsg.payload = [{\n    measurement: msg.measurement,\n    tags: msg.tags,\n    fields: msg.fields,\n    timestamp: msg.timestamp\n}];\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 160,
        "wires": [
            ["influxdb-write", "check-threshold"]
        ]
    },
    {
        "id": "influxdb-write",
        "type": "influxdb out",
        "z": "ming-flow-tab-main",
        "influxdb": "influxdb-config",
        "name": "Write to InfluxDB",
        "measurement": "",
        "precision": "ms",
        "retentionPolicy": "",
        "database": "",
        "precisionV18FluxV20": "ms",
        "retentionPolicyV18Flux": "",
        "org": "ming-org",
        "bucket": "factory",
        "x": 670,
        "y": 160,
        "wires": []
    },
    {
        "id": "check-threshold",
        "type": "function",
        "z": "ming-flow-tab-main",
        "name": "Check Threshold",
        "func": "// 임계값 체크\nconst thresholds = {\n    temperature: { min: 10, max: 40 },\n    humidity: { min: 20, max: 80 },\n    pressure: { min: 0.8, max: 1.5 }\n};\n\nconst alerts = [];\nconst fields = msg.fields || {};\n\nfor (const [key, value] of Object.entries(fields)) {\n    if (thresholds[key]) {\n        const t = thresholds[key];\n        if (value < t.min || value > t.max) {\n            alerts.push({\n                field: key,\n                value: value,\n                threshold: t,\n                status: value < t.min ? 'LOW' : 'HIGH'\n            });\n        }\n    }\n}\n\nif (alerts.length > 0) {\n    msg.payload = {\n        type: 'threshold_alert',\n        location: msg.tags,\n        alerts: alerts,\n        timestamp: new Date().toISOString()\n    };\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 220,
        "wires": [
            ["mqtt-alert-publish"]
        ]
    },
