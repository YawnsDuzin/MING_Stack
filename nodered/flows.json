    {
        "id": "modbus-transform",
        "type": "function",
        "z": "ming-flow-tab-modbus",
        "name": "Transform Modbus Data",
        "func": "// Modbus 레지스터 값을 실제 값으로 변환\nconst registers = msg.payload;\n\n// 예시: 레지스터 매핑\n// 0: 온도 (x0.1)\n// 1: 습도 (x0.1)\n// 2: 압력 (x0.01)\n// 3: 모터 속도 (RPM)\n// 4: 전류 (x0.01 A)\n// 5-9: 예비\n\nconst data = {\n    temperature: registers[0] / 10,\n    humidity: registers[1] / 10,\n    pressure: registers[2] / 100,\n    motor_speed: registers[3],\n    current: registers[4] / 100\n};\n\n// MQTT로 발행할 메시지 구성\nmsg.topic = 'factory/line1/modbus_device/data';\nmsg.payload = data;\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 120,
        "wires": [
            ["mqtt-publish-modbus", "debug-modbus"]
        ]
    },
