# =============================================================================
# MING Stack Environment Variables
# 라즈베리파이 4/5 산업용 IoT 플랫폼
# =============================================================================
# 이 파일을 .env로 복사하여 사용하세요: cp .env.example .env

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ming
TIMEZONE=Asia/Seoul

# -----------------------------------------------------------------------------
# Host Settings (라즈베리파이 IP 설정)
# -----------------------------------------------------------------------------
# 자동 감지되지만, 고정 IP 사용 시 설정
# HOST_IP=192.168.1.100

# -----------------------------------------------------------------------------
# InfluxDB Settings
# -----------------------------------------------------------------------------
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin123456
INFLUXDB_ORG=ming-org
INFLUXDB_BUCKET=factory
INFLUXDB_TOKEN=ming-super-secret-token
INFLUXDB_RETENTION=7d
INFLUXDB_PORT=8086

# 메모리 제한 (Pi 5 8GB: 1G, Pi 4 4GB: 512M)
INFLUXDB_MEMORY_LIMIT=1G

# -----------------------------------------------------------------------------
# Node-RED Settings
# -----------------------------------------------------------------------------
NODERED_CREDENTIAL_SECRET=ming-secret-key
NODERED_PORT=1880

# 메모리 제한 (Pi 5 8GB: 512M, Pi 4 4GB: 384M)
NODERED_MEMORY_LIMIT=512M

# -----------------------------------------------------------------------------
# Grafana Settings
# -----------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_PORT=3000

# 메모리 제한 (Pi 5 8GB: 256M, Pi 4 4GB: 192M)
GRAFANA_MEMORY_LIMIT=256M

# -----------------------------------------------------------------------------
# MQTT (Mosquitto) Settings
# -----------------------------------------------------------------------------
MQTT_USER=mqtt_user
MQTT_PASSWORD=mqtt_pass
MQTT_PORT=1883
MQTT_WS_PORT=9001

# -----------------------------------------------------------------------------
# Industrial Protocol Simulators
# -----------------------------------------------------------------------------
# 시뮬레이터 활성화: docker compose --profile simulators up -d
ENABLE_SIMULATORS=true

# 포트 설정
MODBUS_PORT=5020
OPCUA_PORT=4840
S7_PORT=1102

# -----------------------------------------------------------------------------
# Raspberry Pi 5 Specific Settings
# -----------------------------------------------------------------------------
# Pi 5는 더 많은 메모리와 CPU를 활용할 수 있습니다
# 아래 설정은 Pi 5 8GB 기준 권장값입니다

# Pi 4 4GB 사용 시 아래 주석 해제:
# INFLUXDB_MEMORY_LIMIT=512M
# NODERED_MEMORY_LIMIT=384M
# GRAFANA_MEMORY_LIMIT=192M

# -----------------------------------------------------------------------------
# Management Tools (Portainer)
# -----------------------------------------------------------------------------
# 관리 도구 활성화: docker compose --profile management up -d
PORTAINER_PORT=9000

# -----------------------------------------------------------------------------
# Security (프로덕션 환경에서는 반드시 변경!)
# -----------------------------------------------------------------------------
# 아래 값들은 테스트용 기본값입니다.
# 프로덕션 환경에서는 강력한 비밀번호로 변경하세요:
#
# INFLUXDB_PASSWORD=your_strong_password_here
# INFLUXDB_TOKEN=your_random_token_here
# GRAFANA_PASSWORD=your_strong_password_here
# MQTT_PASSWORD=your_strong_password_here
# NODERED_CREDENTIAL_SECRET=your_random_secret_here
